# CoinGecko (server-side only — never expose in frontend)
COINGECKO_API_KEY=

# Set to "false" for CoinGecko Demo API keys (uses x-cg-demo-api-key header)
# Set to "true" or omit for Pro API keys (uses x-cg-pro-api-key header)
COINGECKO_USE_PRO_API=false

# Optional — public site URL for metadata (defaults to https://trade-twin.vercel.app)
# NEXT_PUBLIC_APP_URL=https://trade-twin.vercel.app

# Optional — Monadscan / Etherscan V2 key for faster wallet transfer history
# Get a free key at https://etherscan.io/apis (works for Monad testnet via chainid=10143)
# MONADSCAN_API_KEY=

# NEXT_PUBLIC_REGISTRY_ADDRESS=0x...

# For CLI deployment only (never commit real keys)
# DEPLOYER_PRIVATE_KEY=0x...
